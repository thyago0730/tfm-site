{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      { "regex": "^/(site/)?sobre-a-tfm-revestimentos/?$", "destination": "/#sobre", "type": 301 },
      { "regex": "^/(site/)?servicos/?$", "destination": "/#servicos", "type": 301 },
      { "regex": "^/(site/)?servicos/.+$", "destination": "/#setores", "type": 301 },
      { "regex": "^/(site/)?segmentos-e-aplicacoes/?$", "destination": "/#setores", "type": 301 },
      { "regex": "^/(site/)?projetos-tfm/?$", "destination": "/#cases", "type": 301 },
      { "regex": "^/(site/)?portfolio(-category)?(/.*)?$", "destination": "/#cases", "type": 301 },
      { "regex": "^/(site/)?contato-tfm-revestimentos/?$", "destination": "/#contato", "type": 301 },
      { "regex": "^/site/wp-content/uploads/2021/02/PORTIFOLIO.*\\.pdf$", "destination": "/docs/tfm-portfolio-de-servicos.pdf", "type": 301 },
      { "regex": "^/site/wp-content/uploads/2021/02/app_institucional.*\\.pdf$", "destination": "/docs/tfm-institucional.pdf", "type": 301 },
      { "regex": "^/(site|blog|feed)/?$", "destination": "/", "type": 301 },
      { "regex": "^/author/.*$", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|pdf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      }
    ]
  }
}
