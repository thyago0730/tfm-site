# TFM Revestimentos — configuração para hospedagem Apache

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirecionamentos 301 das URLs do site antigo (WordPress) — preserva SEO
  RewriteRule ^(site/)?sobre-a-tfm-revestimentos/?$ /#sobre [NE,L,R=301]
  RewriteRule ^(site/)?servicos/?$ /#servicos [NE,L,R=301]
  RewriteRule ^(site/)?servicos/.+$ /#setores [NE,L,R=301]
  RewriteRule ^(site/)?segmentos-e-aplicacoes/?$ /#setores [NE,L,R=301]
  RewriteRule ^(site/)?projetos-tfm/?$ /#cases [NE,L,R=301]
  RewriteRule ^(site/)?portfolio(-category)?(/.*)?$ /#cases [NE,L,R=301]
  RewriteRule ^(site/)?contato-tfm-revestimentos/?$ /#contato [NE,L,R=301]
  RewriteRule ^site/wp-content/uploads/2021/02/PORTIFOLIO.*\.pdf$ /docs/tfm-portfolio-de-servicos.pdf [L,R=301]
  RewriteRule ^site/wp-content/uploads/2021/02/app_institucional.*\.pdf$ /docs/tfm-institucional.pdf [L,R=301]
  RewriteRule ^(site/?|blog/?|feed/?|author/.*)$ / [L,R=301]

  # Qualquer outra URL inexistente volta para a home
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
